# edge_z1.log, ...) overwritten by every single simulation run -- tracking
# them just produces noise, never meaningful history. Locked/canonical
# results live in paper_artifact_v1.0/results/, not here.
logs/

# Python bytecode cache -- pure build artifact, never meaningful to track.
__pycache__/
*.pyc

# Full ns-3 build tree: compiled binaries, cmake cache, and (accidentally)
