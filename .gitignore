# a standard upstream download (see paper_artifact_v1.0/README.md Step 1),
# not project source, and should never be tracked.
ns-allinone-3.41/
ns-allinone-3.41_GENERIC_UNUSED_backup/
ns-allinone-3.41.tar.bz2

# Redundant packaged archives -- the actual content is already tracked as
# real files elsewhere in the repo; these are stale zipped duplicates.
v2x-multiuav-trust-paper-artifact-v1.0.zip
updated_handover_defense_files.zip

# Another full ns-3 tree backup with its own nested .git (same broken-submodule issue).
backups/ns-allinone-3.41_slic_backup_20260624_131039/ns-3.41/

