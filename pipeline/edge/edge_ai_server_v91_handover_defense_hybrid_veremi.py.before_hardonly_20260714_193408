def recv_framed(conn):
    try:
        raw = b""
        while len(raw) < 4:
            chunk = conn.recv(4 - len(raw))
            if not chunk: return None
            raw += chunk
        length = struct.unpack("!I", raw)[0]
        if length == 0 or length > 65536: return None
        data = b""
        while len(data) < length:
            chunk = conn.recv(length - len(data))
            if not chunk: return None
            data += chunk
        return data.decode("utf-8", errors="replace").strip()
    except Exception:
        return None

def send_framed(conn, msg):
    try:
        encoded = msg.encode("utf-8")
        conn.sendall(struct.pack("!I", len(encoded)) + encoded)
        return True
    except Exception:
        return False

# =============================================================================
# [MU-2] OUTBOUND TCP HELPER  (coordinator calls)
# =============================================================================

def tcp_call_framed(host, port, payload_str,
                    timeout_s=None, want_response=True):
    """Send a framed message; optionally read a response. Returns str or None."""
    ts = timeout_s or COORD_TIMEOUT_S
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(ts)
        s.connect((host, port))
        enc = payload_str.encode("utf-8")
        s.sendall(struct.pack("!I", len(enc)) + enc)
        if not want_response:
            s.close()
            return "SENT"
        raw = b""
        while len(raw) < 4:
            chunk = s.recv(4 - len(raw))
            if not chunk: break
            raw += chunk
        if len(raw) == 4:
            length = struct.unpack("!I", raw)[0]
            if 0 < length <= 131072:
                data = b""
                while len(data) < length:
                    chunk = s.recv(length - len(data))
                    if not chunk: break
                    data += chunk
                s.close()
                return data.decode("utf-8", errors="replace").strip()
        s.close()
    except Exception:
        pass
    return None

# =============================================================================
# PARSERS  (unchanged from v85)
# =============================================================================

def parse_telem(msg):
    parts = msg.split()
    if not parts or parts[0] != "TELEM": return None
    d = {}
    for p in parts[1:]:
        if ":" in p:
            k, v = p.split(":", 1)
            try:    d[k] = float(v)
            except: d[k] = v
    required = {"CID", "TS", "SPD", "HDG", "PX", "PY", "LAN", "SIMNOW",
                "SAFE_WINS", "CLASS"}
    if not required.issubset(d.keys()): return None
    d["CID"]       = int(d["CID"])
    d["LAN"]       = int(d["LAN"])
    d["SAFE_WINS"] = int(d["SAFE_WINS"])
    d["CLASS"]     = int(d["CLASS"])
    return d

def parse_cloud_fb(msg):
    parts = msg.split()
    if not parts or parts[0] != "CLOUD_FB": return None
    d = {}
    for p in parts[1:]:
        if ":" in p:
            k, v = p.split(":", 1)
            d[k] = v
    required = {"CID", "llm_susp", "dominant", "class"}
    if not required.issubset(d.keys()): return None
    if "safe_wins" not in d and "safeWins" not in d: return None
    d["CID"]       = int(d["CID"])
    d["llm_susp"]  = float(d["llm_susp"])
    d["safe_wins"] = int(d.get("safe_wins", d.get("safeWins", 0)))
    d["class"]     = int(d["class"])
    d["sim_ts"]    = float(d.get("sim_ts", -1.0))
    return d

# =============================================================================
# DYNAMIC SPEED THRESHOLD  (unchanged from v85)
# =============================================================================

def get_dynamic_speed_threshold():
    with _state_lock:
        speeds = list(global_speed_history)
    if len(speeds) < 10:
        return SPEED_THRESHOLD_FLOOR
    clean = sorted(s for s in speeds if s <= SPEED_THRESHOLD_CAP)
    if len(clean) < 5:
        return SPEED_THRESHOLD_CAP
    n   = len(clean)
    lo  = max(1, int(n * 0.10))
    hi  = min(n - 1, n - lo)
    trimmed    = clean[lo:hi] if (hi - lo) >= 3 else clean
    median_spd = trimmed[len(trimmed) // 2]
    deviations = sorted(abs(s - median_spd) for s in trimmed)
    mad        = deviations[len(deviations) // 2]
    eff_mad    = max(mad, 0.5)
    robust     = median_spd + 2.5 * eff_mad
    return max(SPEED_THRESHOLD_FLOOR, min(robust, SPEED_THRESHOLD_CAP))

# =============================================================================
# MODELS M1-M5  (unchanged from v85)
# =============================================================================

def model1_speed(spd):
    thresh = get_dynamic_speed_threshold()
    if spd > thresh:
        excess = spd - thresh
        return min(1.0, M1_BASE_SCORE + 0.6 * math.tanh(excess / M1_TANH_SCALE))
    return 0.0

def model2_timestamp(ts, sim_ts, ts_tight_factor=1.0):
    delta            = ts - sim_ts
    tightened_replay = TS_REPLAY_DELTA * ts_tight_factor
    if delta < tightened_replay:
        severity = abs(delta - tightened_replay) / max(0.001, abs(tightened_replay))
        return min(1.0, TS_REPLAY_BASE + TS_REPLAY_SCALE * math.tanh(severity))
    if delta > TS_FUTURE_THRESH:
        severity = (delta - TS_FUTURE_THRESH) / TS_FUTURE_THRESH
        return min(1.0, TS_FUTURE_BASE + TS_FUTURE_SCALE * math.tanh(severity))
    return TS_NORMAL_SCORE

def model3_behaviour(cid, spd, px, py, hdg=None,
                     px_snap=None, hdg_snap=None):
    hist = list(cid_history[cid])
    if len(hist) < 3:
        return M3_DEFAULT_SCORE
    avg_spd     = sum(hist) / len(hist)
    spd_anomaly = M3_DEFAULT_SCORE
    if avg_spd > 0:
        ratio = spd / avg_spd
        if ratio > M3_SPD_RATIO_THRESH:
            spd_anomaly = min(1.0, M3_SPD_BASE
                             + M3_SPD_SCALE * math.tanh(ratio - M3_SPD_RATIO_THRESH))
    pos_anomaly = 0.0
    ph = px_snap or []
    if spd > M3_MIN_SPD_FOR_GPS and len(ph) >= 2:
        dt = ph[-1][0] - ph[0][0]
        if dt > 0.5:
            gps_rate = abs(ph[-1][1] - ph[0][1]) / dt
            if spd > 0 and (gps_rate / spd) < M3_GPS_RATE_THRESH:
                pos_anomaly = M3_GPS_ANOMALY_SCORE
    _ = py
    hdg_anomaly = 0.0
    if hdg is not None:
        h_hist = hdg_snap or []
        if len(h_hist) >= M3_HDG_MIN_HISTORY:
            if not (STOPPED_IGNORE_HDG == 1 and spd <= STOPPED_SPEED_MAX):
                recent = h_hist[-M3_HDG_RECENT_WIN:]
                mean_h = sum(recent) / len(recent)
                var_h  = sum((x - mean_h) ** 2 for x in recent) / len(recent)
                if var_h < M3_HDG_FROZEN_THRESH:
                    hdg_anomaly = M3_HDG_FROZEN_SCORE
                elif var_h < M3_HDG_LOW_THRESH:
                    hdg_anomaly = M3_HDG_LOW_SCORE
    return min(1.0, spd_anomaly + hdg_anomaly + pos_anomaly)

def model4_position_drift(cid, px, sim_ts, spd, px_snap=None):
    fb            = llm_feedback.get(cid, {})
    shadow_active = fb.get("shadow_boost", 1.0) > 1.2
    maxlen        = M4_SHADOW_MAXLEN if shadow_active else M4_NORMAL_MAXLEN
    with _state_lock:
        hist = cid_px_history[cid]
        if hist.maxlen != maxlen:
            cid_px_history[cid] = deque(hist, maxlen=maxlen)
    px_data = px_snap or []
    if len(px_data) < PX_HISTORY_MIN:
        return 0.0
    oldest_ts, oldest_px = px_data[0]
    newest_ts, newest_px = px_data[-1]
    dt = newest_ts - oldest_ts
    if dt < M4_MIN_DT:
        return 0.0
    if spd <= STOPPED_SPEED_MAX:
        return 0.0
    expected_disp = spd * dt
    displacement  = abs(newest_px - oldest_px)
    drift_ratio   = displacement / max(1.0, expected_disp)
    if drift_ratio < M4_FROZEN_RATIO:
        return M4_FROZEN_SCORE
    elif drift_ratio < M4_DRIFT_RATIO:
        return round(M4_DRIFT_SCALE * (1.0 - drift_ratio / M4_DRIFT_RATIO), 3)
    return 0.0

def model5_temporal(cid, spd, sim_ts, px_snap=None):
    fb = llm_feedback.get(cid, {})
    temporal_bias = float(fb.get("temporal_bias", 0.0))
    with _state_lock:
        spd_hist = list(cid_history[cid])
        ts_hist  = list(cid_ts_history[cid])
    if len(spd_hist) < 3:
        return max(0.0, min(1.0, temporal_bias))
    recent_spd = spd_hist[-5:]
    avg_spd    = sum(recent_spd) / len(recent_spd)
    replay_score = 0.0
    recent_dt    = ts_hist[-5:]
    if len(recent_dt) >= 3:
        avg_delta = sum(recent_dt) / len(recent_dt)
        if avg_delta < (TS_REPLAY_DELTA * 0.95):
            replay_score = 0.35
        elif avg_delta < (TS_REPLAY_DELTA * 0.70):
            replay_score = 0.20
    speed_score = 0.0
    if avg_spd > SPEED_THRESHOLD_FLOOR:
        denom = max(1.0, SPEED_THRESHOLD_CAP - SPEED_THRESHOLD_FLOOR)
        speed_score = min(0.25, 0.25 * max(0.0, avg_spd - SPEED_THRESHOLD_FLOOR) / denom)
    motion_score = 0.0
    px_data = px_snap or []
    if len(px_data) >= 3:
        oldest_ts, oldest_px = px_data[0]
        newest_ts, newest_px = px_data[-1]
        dt = newest_ts - oldest_ts
        if dt >= M4_MIN_DT and avg_spd > STOPPED_SPEED_MAX:
            disp     = abs(newest_px - oldest_px)
            expected = avg_spd * dt
            ratio    = disp / max(1.0, expected)
            if M4_FROZEN_RATIO <= ratio < 0.60:
                motion_score = min(0.30, 0.30 * (0.60 - ratio)
                                   / max(0.05, 0.60 - M4_FROZEN_RATIO))
    m5 = replay_score + speed_score + motion_score + temporal_bias
    return min(1.0, max(0.0, round(m5, 3)))

# =============================================================================
# ENSEMBLE SCORER  (unchanged from v85)
# =============================================================================

def ensemble_score(cid, ts, spd, hdg, px, py, lan, sim_ts,
                   px_snap=None, hdg_snap=None):
    fb           = llm_feedback.get(cid, {})
    shadow_boost = fb.get("shadow_boost", 1.0)
    ts_tight     = fb.get("ts_tight_factor", 1.0)
    m1 = model1_speed(spd)
    m2 = model2_timestamp(ts, sim_ts, ts_tight)
    m3 = model3_behaviour(cid, spd, px, py, hdg,
                          px_snap=px_snap, hdg_snap=hdg_snap)
    m4 = model4_position_drift(cid, px, sim_ts, spd, px_snap=px_snap)
    m5 = model5_temporal(cid, spd, sim_ts, px_snap=px_snap)
    m2 = min(1.0, max(0.0, m2 + float(fb.get("ts_bias", 0.0))))
    m4 = min(1.0, max(0.0, m4 + float(fb.get("px_bias", 0.0))))
    m5 = min(1.0, max(0.0, m5 + float(fb.get("hidden_promote", 0.0))))
    with _state_lock:
        ts_deltas = list(cid_ts_history[cid])
    if len(ts_deltas) >= TS_BOOST_MIN_PKTS:
        avg_delta = sum(ts_deltas) / len(ts_deltas)
        if avg_delta < TS_BOOST_THRESHOLD:
            old_m2 = m2
            m2 = min(1.0, m2 + TS_BOOST_AMOUNT)
            print("[EDGE-TS-HIST] CID:%d avg_delta=%.3f m2 %.3f->%.3f"
                  % (cid, avg_delta, old_m2, m2))
    with weight_lock:
        w1 = weights["W1"]; w2 = weights["W2"]
        w3 = weights["W3"]; w4 = weights["W4"]; w5 = weights["W5"]
    _wt = w1 + w2 + w3 + w4 + w5
    if _wt > 0:
        w1, w2, w3, w4, w5 = w1/_wt, w2/_wt, w3/_wt, w4/_wt, w5/_wt
    raw_p_edge = (w1*m1 + w2*m2 + w3*m3 + w4*m4 + w5*m5) * shadow_boost
    if len(px_snap or []) < 3 and m2 >= EARLY_TS_STRONG:
        raw_p_edge = min(1.0, raw_p_edge + EARLY_TS_BONUS)
    if len(px_snap or []) == 2 and m4 == 0.0:
        dt = (px_snap[-1][0] - px_snap[0][0]) if px_snap else 0.0
        if dt >= M4_MIN_DT:
            expected_disp = spd * dt
            displacement  = abs(px_snap[-1][1] - px_snap[0][1])
            drift_ratio   = displacement / max(1.0, expected_disp)
            if drift_ratio < M4_FROZEN_RATIO:
                m4 = max(m4, EARLY_FROZEN_PX_SCORE)
                raw_p_edge = min(1.0, (w1*m1 + w2*m2 + w3*m3 + w4*m4 + w5*m5) * shadow_boost)
    p_edge    = raw_p_edge
    safe_wins = cid_safeWins.get(cid, 0)
    if safe_wins > 0:
        discount = min(REPUTATION_CAP, safe_wins * REPUTATION_RATE)
        discount *= _handover_discount_factor(cid)
        if raw_p_edge >= REPUTATION_HARD_CUTOFF:
            discount *= REPUTATION_HARD_SCALE
        elif raw_p_edge >= REPUTATION_SOFT_CUTOFF:
            discount *= REPUTATION_SOFT_SCALE
        p_edge = max(0.0, raw_p_edge - discount)
    p_edge = min(1.0, max(0.0, p_edge))
    with weight_lock:
        cid_last_scores[cid] = {"m1": m1, "m2": m2, "m3": m3, "m4": m4, "m5": m5}
    return m1, m2, m3, m4, m5, p_edge

# =============================================================================
# NASH VERDICT  (unchanged from v85)
# =============================================================================

def nash_verdict(cid, llm_susp):
    with _state_lock:
        spd_hist        = list(cid_history[cid])
        px_hist         = list(cid_px_history[cid])
        vclass          = cid_vehicle_class.get(cid, 0)
        safe_wins       = cid_safeWins.get(cid, 0)
        edge_ban_streak  = int(cid_ban_streak[cid])
        edge_warn_streak = int(cid_warn_streak[cid])
        was_edge_banned  = (cid in confirmed_banned_set)
        fb = dict(llm_feedback.get(cid, {}))
    spd_susp = model1_speed(sum(spd_hist) / len(spd_hist)) if spd_hist else 0.0
    px_susp  = 0.0
    if len(px_hist) >= PX_HISTORY_MIN:
        oldest_ts, oldest_px = px_hist[0]
        newest_ts, newest_px = px_hist[-1]
        dt = newest_ts - oldest_ts
        if dt > 0.5:
            avg_spd = sum(spd_hist) / len(spd_hist) if spd_hist else 20.0
            if avg_spd > STOPPED_SPEED_MAX:
                expected_disp = avg_spd * dt
                disp  = abs(newest_px - oldest_px)
                ratio = disp / max(1.0, expected_disp)
                if ratio < M4_FROZEN_RATIO:
                    px_susp = M4_FROZEN_SCORE
                elif ratio < M4_DRIFT_RATIO:
                    px_susp = round(M4_DRIFT_SCALE * (1.0 - ratio / M4_DRIFT_RATIO), 3)
    spd_px_edge_susp = NASH_SPD_WEIGHT * spd_susp + NASH_PX_WEIGHT * px_susp
    with weight_lock:
        last = dict(cid_last_scores.get(cid, {}))
        w1 = float(weights.get("W1", W1)); w2 = float(weights.get("W2", W2))
        w3 = float(weights.get("W3", W3)); w4 = float(weights.get("W4", W4))
        w5 = float(weights.get("W5", W5))
    _wt = w1 + w2 + w3 + w4 + w5
    if _wt > 0:
        w1, w2, w3, w4, w5 = w1/_wt, w2/_wt, w3/_wt, w4/_wt, w5/_wt
    prior_edge_susp = 0.0
    if last:
        prior_edge_susp = min(1.0, max(0.0,
            w1*float(last.get("m1",0.0)) + w2*float(last.get("m2",0.0))
          + w3*float(last.get("m3",0.0)) + w4*float(last.get("m4",0.0))
          + w5*float(last.get("m5",0.0))))
    edge_evidence = max(
        spd_px_edge_susp,
        NASH_EDGE_PRIOR_WEIGHT * prior_edge_susp
        + (1.0 - NASH_EDGE_PRIOR_WEIGHT) * spd_px_edge_susp,
    )
    strong_edge_ban  = (was_edge_banned or edge_ban_streak > 0
                        or prior_edge_susp >= ZONE_MALICIOUS)
    repeated_edge_ban = (edge_ban_streak >= 2 or prior_edge_susp >= 0.50)
    teach   = float(fb.get("teach_strength", 0.0))
    hidden  = float(fb.get("hidden_promote", 0.0))
    promote = int(fb.get("promote_safe", 0))
    llm_effective = min(1.0, max(0.0,
        llm_susp + float(fb.get("edge_delta", 0.0))
        + NASH_TEACH_DIRECT_WEIGHT * teach
        + NASH_HIDDEN_DIRECT_WEIGHT * hidden))
    # [OPTION-A] Decouple LLM from the verdict path for determinism/safety.
    # llm_effective is zeroed (not just NASH_LLM_WEIGHT) so every downstream
    # use -- the weighted sum in p_comb AND the independent threshold gates
    # (NASH_LLM_RESCUE_BAN, NASH_LLM_TRUST_VETO) -- is consistently disabled.
    # The Ollama call above is UNCHANGED and still runs, so dominant_anomaly/
    # summary remain available for human-readable logging; only the numeric
    # contribution to the verdict is removed.
    if DISABLE_LLM_DECISION:
        llm_effective = 0.0
    tuned_edge_evidence = min(1.0, max(0.0,
        edge_evidence + 0.20*teach + 0.35*hidden))
    p_comb = min(1.0, max(0.0,
        NASH_LLM_WEIGHT * llm_effective + NASH_EDGE_WEIGHT * tuned_edge_evidence))
    if promote == 1:
        p_comb = max(p_comb,
                     NASH_PROMOTE_WARN_FLOOR + 0.10*min(1.0,hidden) + 0.05*min(1.0,teach))
    if strong_edge_ban:
        p_comb = max(p_comb, NASH_EDGE_WARN_FLOOR)
        if repeated_edge_ban or llm_effective >= NASH_LLM_RESCUE_BAN or promote == 1:
            floor = NASH_EDGE_BAN_STRONG_FLOOR if repeated_edge_ban else NASH_EDGE_BAN_FLOOR
            if promote == 1 and (teach >= NASH_TEACH_BAN_GATE or hidden >= 0.08):
                floor = max(floor, NASH_PROMOTE_BAN_FLOOR)
            p_comb = max(p_comb, floor)
    if safe_wins > 0:
        rep_disc = min(REPUTATION_CAP, safe_wins * REPUTATION_RATE)
        rep_disc *= _handover_discount_factor(cid)
        if p_comb >= REPUTATION_HARD_CUTOFF:
            rep_disc *= REPUTATION_HARD_SCALE
        elif p_comb >= REPUTATION_SOFT_CUTOFF:
            rep_disc *= REPUTATION_SOFT_SCALE
        p_comb = max(0.0, p_comb - rep_disc)
        if strong_edge_ban:
            p_comb = max(p_comb, NASH_EDGE_WARN_FLOOR)
    thr = float(NASH_BAN_THRESHOLD)
    if vclass == 1:
        ban_reward     = NASH_BAN_REWARD     * EMG_BAN_REWARD_MULT
        false_ban_cost = NASH_FALSE_BAN_COST * EMG_FALSE_BAN_MULT
        chase_cost     = NASH_CHASE_COST     * EMG_CHASE_COST_MULT
    else:
        ban_reward     = NASH_BAN_REWARD
        false_ban_cost = NASH_FALSE_BAN_COST
        chase_cost     = NASH_CHASE_COST
    eu_ban   = p_comb * ban_reward - (1.0 - p_comb) * false_ban_cost
    eu_trust = (1.0 - p_comb) * NASH_REWARD - p_comb * chase_cost
    ban_candidate = (p_comb > thr and eu_ban > eu_trust)
    if strong_edge_ban and not ban_candidate and NASH_MIN_WARN_ON_EDGE_BAN == 1 and llm_effective > NASH_LLM_TRUST_VETO:
        warn_candidate = True
    else:
        warn_candidate = (edge_warn_streak > 0 and p_comb >= ZONE_SAFE)
    if not warn_candidate and not ban_candidate:
        if promote == 1 and (teach >= 0.35 or hidden >= 0.05) and (strong_edge_ban or edge_warn_streak > 0):
            warn_candidate = True
        elif hidden >= 0.08 and llm_effective >= 0.35:
            warn_candidate = True
    with _state_lock:
        if ban_candidate:
            cid_nash_ban_streak[cid] += 1
        else:
            cid_nash_ban_streak[cid] = 0
        streak = cid_nash_ban_streak[cid]
    strong_cloud_ban = (
        strong_edge_ban and promote == 1
        and llm_effective >= 0.90
        and p_comb >= max(float(NASH_BAN_THRESHOLD), NASH_PROMOTE_BAN_FLOOR)
    )
    verdict = "TRUST"
    if ban_candidate:
        if strong_cloud_ban or streak >= max(1, int(NASH_BAN_CONFIRM_K)):
            verdict = "BAN"
            with _state_lock:
                confirmed_banned_set.add(cid)
                cid_nash_ban_streak[cid] = max(
                    cid_nash_ban_streak[cid], max(1, int(NASH_BAN_CONFIRM_K)))
        else:
            verdict = "WARN"
    elif warn_candidate:
        verdict = "WARN"
    return {
        "verdict":      verdict,
        "p_comb":       round(p_comb, 3),
        "nash_p*":      round(thr, 4),
        "eu_ban":       round(eu_ban, 3),
        "eu_trust":     round(eu_trust, 3),
        "ban_k":        int(NASH_BAN_CONFIRM_K),
        "ban_streak":   int(streak),
        "edge_prior":   round(prior_edge_susp, 3),
        "edge_evidence":round(edge_evidence, 3),
    }

# =============================================================================
# ONLINE WEIGHT LEARNING  (unchanged from v85)
# =============================================================================

def update_weights(cid, llm_susp):
    # [OPTION-A] Weights (W1-W5) are adaptive/online-learned from LLM-derived
    # feedback (teach_strength, hidden_promote, dominant anomaly class) --
    # this is a second, independent channel through which non-deterministic
    # LLM/cloud feedback could influence future verdicts (in addition to the
    # llm_effective gate already neutralized above). The LEARNING_RATE=0
    # env var alone only freezes the gradient-descent term; the dominant/
    # teach/hidden additions below it are unconditional and NOT covered by
    # LEARNING_RATE. Disabling the whole function keeps weights fixed at
    # their initial W1..W5 values for the full run when DISABLE_LLM_DECISION
    # is set, closing this second leak in one place.
    if DISABLE_LLM_DECISION:
        return
    with weight_lock:
        scores = cid_last_scores.get(cid)
        if scores is None:
            print("[WEIGHT-UPDATE] CID:%d -- no cached scores, skipping" % cid)
            return
        m1 = scores["m1"]; m2 = scores["m2"]
        m3 = scores["m3"]; m4 = scores["m4"]; m5 = scores.get("m5", 0.0)
        w1 = weights["W1"]; w2 = weights["W2"]
        w3 = weights["W3"]; w4 = weights["W4"]; w5 = weights["W5"]
        fb     = dict(llm_feedback.get(cid, {}))
        teach  = float(fb.get("teach_strength", 0.0))
        hidden = float(fb.get("hidden_promote", 0.0))
        target = min(1.0, max(0.0,
            llm_susp + float(fb.get("edge_delta", 0.0)) + 0.15*teach + 0.40*hidden))
        ensemble = w1*m1 + w2*m2 + w3*m3 + w4*m4 + w5*m5
        error    = ensemble - target
        weights["W1"] = max(0.0, min(1.0, w1 - LEARNING_RATE*error*m1))
        weights["W2"] = max(0.0, min(1.0, w2 - LEARNING_RATE*error*m2))
        weights["W3"] = max(0.0, min(1.0, w3 - LEARNING_RATE*error*m3))
        weights["W4"] = max(0.0, min(1.0, w4 - LEARNING_RATE*error*m4))
        weights["W5"] = max(0.0, min(1.0, w5 - LEARNING_RATE*error*m5))
        dominant = str(fb.get("dominant", ""))
        if dominant in ("replay_ts", "slight_ts_offset"):
            weights["W2"] += 0.05*teach; weights["W5"] += 0.04*teach
        elif dominant in ("frozen_position",):
            weights["W4"] += 0.06*teach; weights["W5"] += 0.05*teach
        elif dominant in ("stealthy_speed", "speed_spike"):
            weights["W1"] += 0.05*teach; weights["W5"] += 0.04*teach
        if hidden > 0.0:
            weights["W5"] += 0.05*hidden
        for k in weights:
            if weights[k] < W_MIN: weights[k] = W_MIN
        total = sum(weights[k] for k in weights)
        if total > 0:
            for k in weights: weights[k] = round(weights[k] / total, 4)
        print("[WEIGHT-UPDATE] CID:%d ensemble=%.3f target=%.3f error=%.3f "
              "W1=%.3f W2=%.3f W3=%.3f W4=%.3f W5=%.3f"
              % (cid, ensemble, target, error,
                 weights["W1"], weights["W2"], weights["W3"],
                 weights["W4"], weights["W5"]))

