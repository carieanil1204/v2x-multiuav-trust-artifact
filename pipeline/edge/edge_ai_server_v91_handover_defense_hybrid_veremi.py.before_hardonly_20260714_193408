VEREMI_MAX_GAP         = float(os.environ.get("VEREMI_MAX_GAP", "3.0"))
VEREMI_MAX_SPEED       = float(os.environ.get("VEREMI_MAX_SPEED", "35.0"))

VEREMI_HARD_SCORE      = float(os.environ.get("VEREMI_HARD_SCORE", "0.95"))
VEREMI_SOFT_SCORE      = float(os.environ.get("VEREMI_SOFT_SCORE", "0.35"))
VEREMI_CLEAN_SCORE     = float(os.environ.get("VEREMI_CLEAN_SCORE", "0.02"))

_veremi_state = defaultdict(lambda: {
    "prev_ts": None,
    "prev_px": None,
    "prev_spd": None,
    "max_ts": None,
    "streak": 0,
})

def veremi_physical_evidence(cid, ts, spd, px, sim_ts):
    """
    Online version of the Full-VeReMi combined_core idea:
      - timestamp replay/non-monotonicity using high-water mark
      - position prediction consistency
      - speed-position consistency
      - raw speed plausibility

    It returns a physical suspicion score p_veremi.
    K=2 means one replay/frozen packet plus the following recovery discontinuity
    becomes strong physical evidence.
    """
    st = _veremi_state[cid]
    reasons = []
    details = {}

    prev_ts = st["prev_ts"]
    prev_px = st["prev_px"]
    prev_spd = st["prev_spd"]
    max_ts = st["max_ts"]

    # C2b: claimed timestamp replay/non-monotonicity.
    # Use max seen TS, not only immediate previous TS, so exact repeats are caught.
    if max_ts is not None and ts <= max_ts + VEREMI_TS_SLACK:
        reasons.append("ts_nonmonotonic")
        details["ts"] = round(ts, 3)
        details["max_ts"] = round(max_ts, 3)

    # C4: raw speed sanity.
    if abs(spd) > VEREMI_MAX_SPEED:
        reasons.append("simple_speed")
        details["spd"] = round(spd, 3)

    # C1/C3: position prediction and speed-position consistency.
    if prev_ts is not None and prev_px is not None and prev_spd is not None:
        dt = ts - prev_ts
        if dt > 0.0 and dt <= VEREMI_MAX_GAP:
            expected_px = prev_px + prev_spd * dt
            pos_err = abs(px - expected_px)
            if pos_err > VEREMI_POS_TOL:
                reasons.append("pos_pred_claimed")
                details["pos_err"] = round(pos_err, 3)

            derived_speed = abs((px - prev_px) / dt)
            speed_err = abs(derived_speed - spd)
            if speed_err > VEREMI_SPEED_TOL:
                reasons.append("speed_pos_claimed")
                details["speed_err"] = round(speed_err, 3)
                details["derived_speed"] = round(derived_speed, 3)

    if reasons:
        st["streak"] = int(st.get("streak", 0)) + 1
    else:
        st["streak"] = 0

    if st["streak"] >= VEREMI_MIN_VIOLATIONS:
        p_veremi = VEREMI_HARD_SCORE
    elif reasons:
        p_veremi = VEREMI_SOFT_SCORE
    else:
        p_veremi = VEREMI_CLEAN_SCORE

    # Update state after checking current packet.
    st["prev_ts"] = ts
    st["prev_px"] = px
    st["prev_spd"] = spd
    if max_ts is None or ts > max_ts:
        st["max_ts"] = ts

    return {
        "p_veremi": max(0.0, min(1.0, p_veremi)),
        "reasons": reasons,
        "streak": st["streak"],
        "details": details,
    }

