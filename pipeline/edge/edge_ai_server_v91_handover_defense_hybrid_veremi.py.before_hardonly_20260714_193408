except ImportError:
    class DecisionTracer:
        def __init__(self, *a, **kw): pass
        def event(self, *a, **kw):    pass
    def make_trace_id(cid, ts):
        return "%s_%.3f" % (cid, float(ts))

TRACER = DecisionTracer("edge")

def trace_event(stage, cid=None, sim_time=None, trace_id=None,
                event_level="detail", **fields):
    try:
        TRACER.event(stage=stage, cid=cid, sim_time=sim_time,
                     trace_id=trace_id, event_level=event_level, **fields)
    except Exception:
        pass

def trace_decision(stage, cid, verdict, reason="", sim_time=None,
                   trace_id=None, event_level="detail", **fields):
    try:
        TRACER.decision(stage=stage, cid=cid, verdict=verdict, reason=reason,
                        sim_time=sim_time, trace_id=trace_id,
                        event_level=event_level, **fields)
    except Exception:
        pass

