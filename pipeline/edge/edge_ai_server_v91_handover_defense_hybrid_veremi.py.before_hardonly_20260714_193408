def build_telem_response(cid, ts, spd, hdg, px, py, lan,
                          m1, m2, m3, m4, m5, p_edge, verdict, sim_ts):
    susp       = round(p_edge, 3)
    clean_conf = round(max(0.0, 1.0 - p_edge), 3)
    prefix     = "BAN" if verdict == "BAN" else "WARN" if verdict == "WARN" else "SAFE"
    with _state_lock:
        first_flag = detection_latency.get(cid, sim_ts)
        hready = _handover_ready.get(cid, 0)
    lat = round(sim_ts - first_flag, 3)
    return (prefix
            + " CID:" + str(cid)
            + " TS:"  + str(round(ts,  3))
            + " SPD:" + str(round(spd, 1))
            + " HDG:" + str(round(hdg, 3))
            + " PX:"  + str(round(px,  3))
            + " PY:"  + str(round(py,  3))
            + " LAN:" + str(lan)
            + " BRK:0"
            + " M1:"  + str(round(m1, 3))
            + " M2:"  + str(round(m2, 3))
            + " M3:"  + str(round(m3, 3))
            + " M4:"  + str(round(m4, 3))
            + " M5:"  + str(round(m5, 3))
            + " SUSP:"        + str(susp)
            + " CLEAN_CONF:"  + str(clean_conf)
            + " LAT:"         + str(lat)
            + " HREADY:"       + str(hready))

