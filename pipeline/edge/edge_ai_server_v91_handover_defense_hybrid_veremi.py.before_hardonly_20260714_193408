def apply_calibration_result(msg):
    import json as _json, time as _time
    global ZONE_MALICIOUS
    json_str = msg[len("CALIBRATION_RESULT"):].strip()
    if not json_str:
        print("[EDGE-CALIB] Empty calibration payload"); return "CALIB_IGNORED empty"
    try:
        data = _json.loads(json_str)
    except Exception as e:
        print("[EDGE-CALIB] Bad JSON: %s" % e); return "CALIB_IGNORED bad_json"
    attack = data.get("attack_type_detected", "unknown")
    conf   = float(data.get("confidence", 0.0))
    sim_ts = float(data.get("sim_ts", 0.0))
    print("[EDGE-CALIB] Received calibration: attack=%s conf=%.2f" % (attack, conf))
    if conf < EDGE_CALIB_MIN_CONFIDENCE:
        print("[EDGE-CALIB] Confidence %.2f < %.2f — ignoring" % (conf, EDGE_CALIB_MIN_CONFIDENCE))
        return "CALIB_IGNORED low_confidence"
    changes = []
    with weight_lock:
        for wk in ("W1","W2","W3","W4","W5"):
            delta = float(data.get(wk + "_delta", 0.0))
            if abs(delta) > 1e-6:
                old_val = weights[wk]
                weights[wk] = round(max(W_MIN, min(1.0, old_val + LEARNING_RATE*delta)), 4)
                changes.append("%s: %.4f→%.4f (Δ%.4f)" % (wk, old_val, weights[wk], delta))
        total = sum(weights[k] for k in weights)
        if total > 0:
            for k in weights: weights[k] = round(weights[k] / total, 4)
    zm_delta = float(data.get("ZONE_MALICIOUS_delta", 0.0))
    if abs(zm_delta) > 1e-6:
        old_zm = ZONE_MALICIOUS
        ZONE_MALICIOUS = round(max(0.10, min(0.60,
            ZONE_MALICIOUS + LEARNING_RATE * zm_delta)), 3)
        changes.append("ZONE_MAL: %.3f→%.3f" % (old_zm, ZONE_MALICIOUS))
    if changes:
        print("[EDGE-CALIB] Applied: " + "  ".join(changes))
        print("[EDGE-CALIB] New weights: W1=%.3f W2=%.3f W3=%.3f W4=%.3f W5=%.3f"
              % (weights["W1"], weights["W2"], weights["W3"],
                 weights["W4"], weights["W5"]))
        try:
            with open("parameter_history.jsonl", "a") as f:
                f.write(_json.dumps({
                    "zone_id": ZONE_ID,
                    "sim_ts": sim_ts, "wall_ts": _time.time(),
                    "attack": attack, "conf": conf, "changes": changes,
                    "W1": weights["W1"], "W2": weights["W2"],
                    "W3": weights["W3"], "W4": weights["W4"],
                    "W5": weights["W5"], "ZONE_MALICIOUS": ZONE_MALICIOUS,
                }) + "\n")
        except Exception:
            pass
    return "CALIB_APPLIED changes=%d sep_before=%.2f sep_after=%.2f" % (
        len(changes),
        float(data.get("sep_before", 0.0)),
        float(data.get("sep_after", 0.0)))

