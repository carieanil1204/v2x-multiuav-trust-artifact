# [MU-5]  SEND TRUST_HANDOVER TO COORDINATOR
# =============================================================================

def send_trust_handover(cid, to_zone, sim_ts):
    """
    Build a TRUST_HANDOVER JSON from local per-CID state and send it to the
    coordinator. Called when this edge receives a TRUST_HANDOVER_TRIGGER from NS3.

    The coordinator forwards it as TRUST_HANDOVER_LOAD to the target zone's edge.
    Returns True if the coordinator acknowledged with "loaded": True.
    """
    with _state_lock:
        spd_hist  = list(cid_history[cid])[-10:]
        ts_hist   = list(cid_ts_history[cid])[-10:]
        safe_wins = cid_safeWins.get(cid, 0)
        w_biases  = dict(llm_feedback.get(cid, {}))
        ban_str   = int(cid_ban_streak[cid])
        warn_str  = int(cid_warn_streak[cid])
        ban_count = stats[cid].get("ban", 0)
        vclass    = cid_vehicle_class.get(cid, 0)
        is_banned = cid in confirmed_banned_set

    with weight_lock:
        last_scores = dict(cid_last_scores.get(cid, {}))

    last_score_vals = list(last_scores.values())
    p_edge_last = (sum(last_score_vals) / len(last_score_vals)
                   if last_score_vals else 0.0)

    if is_banned:
        last_verdict = "BAN"
    elif warn_str > 0:
        last_verdict = "WARN"
    else:
        last_verdict = "SAFE"

    payload = {
        "msg_type":         "TRUST_HANDOVER",
        "from_zone":        ZONE_ID,
        "to_zone":          to_zone,
        "cid":              cid,
        # Bayesian state -- alpha/beta live in NS3; edge defaults if not provided
        # NS3 TRUST_HANDOVER_TRIGGER carries these; see handle_trust_handover_trigger
        "alpha":            2.0,
        "beta":             1.0,
        "safe_wins":        safe_wins,
        "ban_count":        ban_count,
        "p_edge_avg":       p_edge_last,
        "p_edge_last":      p_edge_last,
        "last_verdict":     last_verdict,
        "ban_streak":       ban_str,
        "warn_streak":      warn_str,
        "w_biases": {
            "b_ts":          float(w_biases.get("ts_bias",       0.0)),
            "b_px":          float(w_biases.get("px_bias",       0.0)),
            "temporal_bias": float(w_biases.get("temporal_bias", 0.0)),
            "shadow_boost":  float(w_biases.get("shadow_boost",  1.0)),
        },
        "spd_hist":         spd_hist,
        "ts_hist":          ts_hist,
        "vehicle_class":    vclass,
        "handover_sim_ts":  sim_ts,
        "handover_wall_ts": time.time(),
        "handover_defense": {
            "trust_decay": True,
            "probation": True,
            "cusum_reset": True,
            "safewin_decay": HANDOVER_SAFEWIN_DECAY,
            "probation_k": POST_HANDOVER_K,
            "rep_factor": POST_HANDOVER_REP_FACTOR,
        },
    }

    resp_str = tcp_call_framed(COORD_HOST, COORD_PORT,
                               json.dumps(payload),
                               timeout_s=COORD_TIMEOUT_S)
    if resp_str:
        try:
            rd = json.loads(resp_str)
            if rd.get("loaded"):
                print("[EDGE-Z%d] HANDOVER OK   CID:%-4d --> Z%d  verdict=%s"
                      % (ZONE_ID, cid, to_zone, last_verdict))
                trace_event("handover_sent_ok", cid=cid, to_zone=to_zone,
                            sim_time=sim_ts, last_verdict=last_verdict)
                return True
        except Exception:
            pass

    print("[EDGE-Z%d] HANDOVER FAIL CID:%-4d --> Z%d  coord_resp=%s"
          % (ZONE_ID, cid, to_zone, repr(resp_str)[:60]))
    trace_event("handover_sent_fail", cid=cid, to_zone=to_zone,
                sim_time=sim_ts, coord_resp=repr(resp_str)[:60])
    return False

