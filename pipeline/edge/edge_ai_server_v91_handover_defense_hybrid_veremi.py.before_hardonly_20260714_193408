_overlap_cids = set()

def _handover_discount_factor(cid):
    """Return reputation-discount multiplier during post-handover probation."""
    if cid in _handover_probation:
        return max(0.0, min(1.0, POST_HANDOVER_REP_FACTOR))
    return 1.0

def _bump_post_handover_counter(cid, sim_ts=None):
    """Advance probation packet count and expire probation after POST_HANDOVER_K packets."""
    if cid not in _handover_probation:
        return
    _post_handover_pkt_count[cid] += 1
    _handover_probation[cid]["pkt_count"] = _post_handover_pkt_count[cid]
    if _post_handover_pkt_count[cid] >= POST_HANDOVER_K:
        meta = _handover_probation.pop(cid, {})
        trace_event("post_handover_probation_end", cid=cid, zone_id=ZONE_ID,
                    pkt_count=_post_handover_pkt_count[cid],
                    from_zone=meta.get("from_zone"), event_level="info")

