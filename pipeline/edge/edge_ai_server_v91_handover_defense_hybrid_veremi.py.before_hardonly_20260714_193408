def send_overlap_score(cid, verdict, p_edge, sim_ts):
    """
    Notify coordinator that this zone is scoring a CID that arrived via
    TRUST_HANDOVER_LOAD (i.e., it's in the overlap region, being scored by both
    zones simultaneously). Non-blocking — failures are silently ignored.
    """
    payload = {
        "msg_type": "OVERLAP_SCORE",
        "zone_id":  ZONE_ID,
        "cid":      cid,
        "verdict":  verdict,
        "p_edge":   round(p_edge, 4),
        "sim_ts":   sim_ts,
    }
    try:
        tcp_call_framed(COORD_HOST, COORD_PORT,
                        json.dumps(payload),
                        timeout_s=1.5,
                        want_response=False)
    except Exception:
        pass

# =============================================================================
# [MU-3]  HANDLE TRUST_HANDOVER_LOAD  (inbound from coordinator)
# =============================================================================

def handle_trust_handover_load(payload, conn):
    """
    Pre-seed all relevant per-CID state from the inherited trust payload.
    Called when a vehicle is approaching from the upstream zone.

    After this call the edge is ready to score the vehicle's first TELEM
    packet with full history and bias context — no cold start.
    """
    try:
        cid = int(payload.get("cid", -1))
        if cid < 0:
            send_framed(conn, json.dumps({"status": "ERROR",
                                          "reason": "missing_cid"}))
            return

        from_zone  = int(payload.get("from_zone", -1))
        sim_ts     = float(payload.get("handover_sim_ts", 0.0))
        last_v     = str(payload.get("last_verdict", "SAFE"))
        safe_wins_raw = int(payload.get("safe_wins",   0))
        safe_wins  = int(max(0, round(safe_wins_raw * HANDOVER_SAFEWIN_DECAY)))
        ban_count  = int(payload.get("ban_count",   0))
        ban_str    = int(payload.get("ban_streak",  0))
        warn_str   = int(payload.get("warn_streak", 0))
        w_biases   = payload.get("w_biases", {})
        spd_hist   = payload.get("spd_hist", [])
        ts_hist    = payload.get("ts_hist",  [])
        vclass     = int(payload.get("vehicle_class", 0))

        with _state_lock:
            # 1. Pre-seed speed history for M1 dynamic threshold
            for v in spd_hist[-10:]:
                cid_history[cid].append(float(v))
                if GLOBAL_SPEED_HISTORY_MODE == "clean_only" and float(v) < ZONE_MALICIOUS:
                    global_speed_history.append(float(v))

            # 2. Pre-seed timestamp delta history for M2 boost
            for v in ts_hist[-10:]:
                cid_ts_history[cid].append(float(v))

            # 3. safe_wins and vehicle class
            cid_safeWins[cid]      = safe_wins
            cid_vehicle_class[cid] = vclass
            _handover_probation[cid] = {
                "from_zone": from_zone,
                "to_zone": ZONE_ID,
                "started_sim_ts": sim_ts,
                "raw_safe_wins": safe_wins_raw,
                "decayed_safe_wins": safe_wins,
                "pkt_count": 0,
            }
            _post_handover_pkt_count[cid] = 0

            # 4. Streak counters for FP guardrails
            cid_ban_streak[cid]  = ban_str
            cid_warn_streak[cid] = warn_str

            # 5. If upstream had confirmed ban, flag immediately
            if last_v == "BAN":
                confirmed_banned_set.add(cid)

            # 6. Store Bayesian state for NS3 context (informational; not used
            #    directly by ensemble but logged and available for diagnostics)
            _handover_state[cid] = {
                "from_zone":        from_zone,
                "alpha":            float(payload.get("alpha", 2.0)),
                "beta":             float(payload.get("beta",  1.0)),
                "safe_wins":        safe_wins,
                "safe_wins_raw":    safe_wins_raw,
                "safewin_decay":    HANDOVER_SAFEWIN_DECAY,
                "probation_k":      POST_HANDOVER_K,
                "ban_count":        ban_count,
                "last_verdict":     last_v,
                "loaded_wall_ts":   time.time(),
                "handover_sim_ts":  sim_ts,
            }

            # 7. Track this CID as in the overlap region
            _overlap_cids.add(cid)

        # 8. Apply cloud teaching biases from upstream zone
        if w_biases:
            with _state_lock:
                llm_feedback[cid] = {
                    "shadow_boost":   float(w_biases.get("shadow_boost",   1.0)),
                    "temporal_bias":  float(w_biases.get("temporal_bias",  0.0)),
                    "ts_bias":        float(w_biases.get("b_ts",           0.0)),
                    "px_bias":        float(w_biases.get("b_px",           0.0)),
                    "teach_strength": 0.0,
                    "hidden_promote": 0.0,
                    "promote_safe":   0,
                    "dominant":       "",
                }

        print("[EDGE-Z%d] HANDOVER_LOAD  CID:%-4d  from_Z%d  "
              "safe_wins_raw=%d decayed=%d decay=%.2f probationK=%d  "
              "ban_str=%d  warn_str=%d  verdict=%s  spd_seeded=%d  ts_seeded=%d"
              % (ZONE_ID, cid, from_zone, safe_wins_raw, safe_wins,
                 HANDOVER_SAFEWIN_DECAY, POST_HANDOVER_K, ban_str, warn_str,
                 last_v, len(spd_hist), len(ts_hist)))
        trace_event("handover_load_applied",
                    cid=cid, from_zone=from_zone, sim_time=sim_ts,
                    safe_wins_raw=safe_wins_raw, safe_wins=safe_wins,
                    safewin_decay=HANDOVER_SAFEWIN_DECAY,
                    probation_k=POST_HANDOVER_K,
                    rep_factor=POST_HANDOVER_REP_FACTOR,
                    ban_streak=ban_str, warn_streak=warn_str,
                    last_verdict=last_v, spd_seeded=len(spd_hist),
                    ts_seeded=len(ts_hist), event_level="info")

        ack = json.dumps({"status": "ACK", "cid": cid,
                          "msg_type": "TRUST_HANDOVER_LOAD_ACK",
                          "zone_id":  ZONE_ID})
        send_framed(conn, ack)

    except Exception as exc:
        print("[EDGE-Z%d] HANDOVER_LOAD exception CID=%s: %s"
              % (ZONE_ID, payload.get("cid", "?"), exc))
        try:
            send_framed(conn, json.dumps({"status": "ERROR", "reason": str(exc)}))
        except Exception:
            pass

# =============================================================================
# [MU-4]  HANDLE TRUST_HANDOVER_TRIGGER  (inbound from NS3 via bridge)
# =============================================================================

def handle_trust_handover_trigger(msg, conn):
    """
    NS3 sends:
        TRUST_HANDOVER_TRIGGER CID:3 FROM_ZONE:1 TO_ZONE:2 SIM_TS:67.4
        [optional: ALPHA:2.3 BETA:4.8]

    The edge builds the full TRUST_HANDOVER payload from local state (plus
    any ALPHA/BETA if NS3 provides them) and forwards to the coordinator.
    """
    parts = msg.split()
    d = {}
    for p in parts[1:]:
        if ":" in p:
            k, v = p.split(":", 1)
            d[k.upper()] = v

    try:
        cid     = int(d.get("CID",       -1))
        to_zone = int(d.get("TO_ZONE",    2))
        sim_ts  = float(d.get("SIM_TS",  0.0))
        # If NS3 provides alpha/beta in this message, patch them into local state
        # before calling send_trust_handover() so they're included in the payload.
        alpha   = float(d.get("ALPHA",   0.0))
        beta    = float(d.get("BETA",    0.0))
    except Exception as exc:
        print("[EDGE-Z%d] TRUST_HANDOVER_TRIGGER parse error: %s" % (ZONE_ID, exc))
        send_framed(conn, "ERROR handover_trigger_parse: %s" % exc)
        return

    if cid < 0:
        send_framed(conn, "ERROR missing_cid")
        return

    # Patch alpha/beta into _handover_state if provided by NS3
    if alpha > 0.0 or beta > 0.0:
        with _state_lock:
            if cid in _handover_state:
                if alpha > 0.0: _handover_state[cid]["alpha"] = alpha
                if beta  > 0.0: _handover_state[cid]["beta"]  = beta
            else:
                _handover_state[cid] = {
                    "alpha": alpha if alpha > 0.0 else 2.0,
                    "beta":  beta  if beta  > 0.0 else 1.0,
                }

    # Build and dispatch handover in a background thread so NS3 gets an
    # immediate ACK and is not blocked waiting for coordinator round-trip.
    def _dispatch():
        # Reload alpha/beta from patched state for inclusion in payload
        with _state_lock:
            hs = _handover_state.get(cid, {})

        ok = send_trust_handover(cid, to_zone, sim_ts)
        if ok:
            with _state_lock:
                _handover_ready[cid] = to_zone
            # Patch alpha/beta back into payload that was already forwarded
            # (coordinator received it; nothing to patch retroactively, but
            #  log it for diagnostics)
            print("[EDGE-Z%d] HANDOVER_TRIGGER complete  CID:%-4d  "
                  "alpha=%.2f  beta=%.2f"
                  % (ZONE_ID, cid,
                     hs.get("alpha", 2.0),
                     hs.get("beta",  1.0)))

    threading.Thread(target=_dispatch, daemon=True).start()
    send_framed(conn, "HANDOVER_TRIGGER_ACK CID:%d TO_ZONE:%d" % (cid, to_zone))

# =============================================================================
# CLIENT HANDLER
# =============================================================================

def handle_client(conn, addr):
    try:
        conn.settimeout(10.0)
        msg = recv_framed(conn)
        if msg is None: return

        # ------------------------------------------------------------------
        # RESET  [MU-7] clears handover state too
        # ------------------------------------------------------------------
        if msg.strip() == "RESET":
            with _state_lock:
                should_print = bool(stats)
            if should_print:
                print_metrics()
            with _state_lock:
                confirmed_banned_set.clear()
                cid_history.clear()
                cid_ts_history.clear()
                cid_px_history.clear()
                cid_heading_history.clear()
                llm_feedback.clear()
                detection_latency.clear()
                cid_safeWins.clear()
                cid_vehicle_class.clear()
                global_speed_history.clear()
                cid_first_warn_simts.clear()
                cid_cloud_fb_simts.clear()
                cid_precloud_verdicts.clear()
                cid_postcloud_verdicts.clear()
                cid_ban_streak.clear()
                cid_warn_streak.clear()
                cid_nash_ban_streak.clear()
                _handover_state.clear()   # [MU-7]
                _handover_probation.clear()  # [HD-DEFENSE]
                _post_handover_pkt_count.clear()  # [HD-DEFENSE]
                _overlap_cids.clear()     # [MU-7]
                for k in list(stats.keys()):
                    stats[k] = {"safe": 0, "warn": 0, "ban": 0, "pkt": 0}
            with weight_lock:
                weights["W1"] = W1; weights["W2"] = W2
                weights["W3"] = W3; weights["W4"] = W4; weights["W5"] = W5
                cid_last_scores.clear()
            print("[EDGE-Z%d] RESET -- all state cleared (zone %d)"
                  % (ZONE_ID, ZONE_ID))
            trace_event("reset", event_level="info", zone_id=ZONE_ID,
                        action="state_cleared",
                        weights={"W1": W1, "W2": W2, "W3": W3, "W4": W4, "W5": W5})
            send_framed(conn, "RESET_OK banned_cleared")
            return

        # ------------------------------------------------------------------
        # CALIBRATION_RESULT  (unchanged)
        # ------------------------------------------------------------------
        if msg.startswith("CALIBRATION_RESULT"):
            result = apply_calibration_result(msg)
            send_framed(conn, result)
            return

        # ------------------------------------------------------------------
        # CLOUD_FB  (unchanged)
        # ------------------------------------------------------------------
        if msg.startswith("CLOUD_FB"):
            fb = parse_cloud_fb(msg)
            if fb is None:
                send_framed(conn, "ERROR invalid CLOUD_FB"); return
            cid      = fb["CID"]
            llm_susp = fb["llm_susp"]
            dominant = fb["dominant"]
            fb_simts = fb["sim_ts"]
            trace_id = make_trace_id(cid, fb_simts if fb_simts >= 0 else 0.0)
            with _state_lock:
                teach_strength = float(fb.get("teach", max(0.0, min(1.0, llm_susp))))
                llm_feedback[cid] = {
                    "shadow_boost":    round(1.0 + llm_susp + max(0.0, float(fb.get("edge_delta", 0.0))), 3),
                    "ts_tight_factor": max(0.35, min(1.0, 1.0 - float(fb.get("ts_bias", 0.0))*2.0))
                                       if dominant in ("replay_ts", "slight_ts_offset") else 1.0,
                    "temporal_bias":   float(fb.get("edge_delta", 0.0)) * 0.15,
                    "ts_bias":         float(fb.get("ts_bias",    0.0)),
                    "px_bias":         float(fb.get("px_bias",    0.0)),
                    "hidden_promote":  float(fb.get("hidden_promote", 0.0)),
                    "teach_strength":  teach_strength,
                    "promote_safe":    int(float(fb.get("promote", 0))),
                    "dominant":        dominant,
                }
                cid_safeWins[cid]       = fb["safe_wins"]
                cid_vehicle_class[cid]  = fb["class"]
                cid_cloud_fb_simts[cid] = fb_simts
                first_warn              = cid_first_warn_simts.get(cid, -1.0)
            if first_warn >= 0 and fb_simts > 0:
                effective_rtt_ms = (fb_simts - first_warn) * 1000.0
            else:
                effective_rtt_ms = CLOUD_RTT_MS
            result = nash_verdict(cid, llm_susp)
            print("[NASH-GT] Z%d CID:%d llm=%.3f p_comb=%.3f thr=%.4f -> %s"
                  % (ZONE_ID, cid, llm_susp, result["p_comb"],
                     result["nash_p*"], result["verdict"]))
            fb_signal = max(llm_susp, teach_strength,
                            float(fb.get("hidden_promote", 0.0)),
                            float(fb.get("edge_delta", 0.0)),
                            float(result.get("p_comb", 0.0)))
            if GLOBAL_WEIGHT_UPDATE_ONLY_ACTIONABLE and result["verdict"] == "TRUST" and fb_signal < GLOBAL_WEIGHT_UPDATE_MIN_SIGNAL:
                print("[WEIGHT-UPDATE] CID:%d skipped (non-actionable fb_signal=%.3f)" % (cid, fb_signal))
            else:
                update_weights(cid, llm_susp)
            resp = ("NASH_VERDICT CID:" + str(cid)
                    + " verdict:"  + result["verdict"]
                    + " p_comb:"   + str(result["p_comb"])
                    + " nash_p*:"  + str(result["nash_p*"])
                    + " eu_ban:"   + str(result["eu_ban"])
                    + " eu_trust:" + str(result["eu_trust"])
                    + " dominant:" + dominant
                    + " rtt_ms:"   + str(round(effective_rtt_ms, 1)))
            send_framed(conn, resp)
            return

        # ------------------------------------------------------------------
        # [MU-3]  TRUST_HANDOVER_LOAD  (JSON from coordinator)
        # ------------------------------------------------------------------
        if msg.startswith("{"):
            try:
                payload = json.loads(msg)
                mt = str(payload.get("msg_type", "")).upper()
                if mt == "TRUST_HANDOVER_LOAD":
                    handle_trust_handover_load(payload, conn)
                    return
            except json.JSONDecodeError:
                pass

        # ------------------------------------------------------------------
        # [MU-4]  TRUST_HANDOVER_TRIGGER  (space-separated KV from NS3/bridge)
        # ------------------------------------------------------------------
        if msg.startswith("TRUST_HANDOVER_TRIGGER"):
            handle_trust_handover_trigger(msg, conn)
            return

        # ------------------------------------------------------------------
        # TELEM  (unchanged logic, + overlap score notification [MU-6])
        # ------------------------------------------------------------------
        if msg.startswith("TELEM"):
            pkt = parse_telem(msg)
            if pkt is None:
                send_framed(conn, "ERROR invalid TELEM"); return

            cid    = pkt["CID"]; ts     = pkt["TS"];   spd  = pkt["SPD"]
            hdg    = pkt["HDG"]; px     = pkt["PX"];   py   = pkt["PY"]
            lan    = pkt["LAN"]; sim_ts = pkt["SIMNOW"]
            safeWins = pkt["SAFE_WINS"]; vclass = pkt["CLASS"]
            trace_id = make_trace_id(cid, sim_ts)

            with _state_lock:
                cid_history[cid].append(spd)
                cid_ts_history[cid].append(ts - sim_ts)
                cid_heading_history[cid].append(hdg)
                cid_px_history[cid].append((sim_ts, px))
                cid_safeWins[cid]      = safeWins
                cid_vehicle_class[cid] = vclass
                already_banned         = cid in confirmed_banned_set
                px_snap                = list(cid_px_history[cid])
                hdg_snap               = list(cid_heading_history[cid])
                cloud_fb_received      = cid in cid_cloud_fb_simts
                in_overlap             = cid in _overlap_cids   # [MU-6]

            if already_banned:
                with weight_lock:
                    last = cid_last_scores.get(
                        cid, {"m1":1.0,"m2":1.0,"m3":1.0,"m4":1.0,"m5":1.0})
                resp = ("BAN CID:" + str(cid)
                        + " TS:"  + str(round(ts,  3))
                        + " SPD:" + str(round(spd, 1))
                        + " HDG:" + str(round(hdg, 3))
                        + " PX:"  + str(round(px,  3))
                        + " PY:"  + str(round(py,  3))
                        + " LAN:" + str(lan)
                        + " BRK:0"
                        + " M1:"  + str(round(last["m1"], 3))
                        + " M2:"  + str(round(last["m2"], 3))
                        + " M3:"  + str(round(last["m3"], 3))
                        + " M4:"  + str(round(last["m4"], 3))
                        + " M5:"  + str(round(last.get("m5", 1.0), 3))
                        + " SUSP:1.000 CLEAN_CONF:0.000 LAT:0.000")
                send_framed(conn, resp)
                with _state_lock:
                    stats[cid]["pkt"] += 1
                    stats[cid]["ban"] += 1
                print("[EDGE-Z%d] CID:%d -> FASTBAN" % (ZONE_ID, cid))
                return

            _bump_post_handover_counter(cid, sim_ts)
            m1, m2, m3, m4, m5, p_edge = ensemble_score(
                cid, ts, spd, hdg, px, py, lan, sim_ts,
                px_snap=px_snap, hdg_snap=hdg_snap)

            # [HYBRID-VEREMI] Compute physical-consistency evidence online.
            veremi_ev = veremi_physical_evidence(cid, ts, spd, px, sim_ts)
            p_veremi = float(veremi_ev.get("p_veremi", 0.0))
            old_p_edge = p_edge
            
            if VEREMI_EVIDENCE_ENABLE:
                if VEREMI_EVIDENCE_MODE == "replace":
                    p_edge = p_veremi
                elif VEREMI_EVIDENCE_MODE == "max":
                    p_edge = max(p_edge, p_veremi)
                # shadow mode intentionally leaves p_edge unchanged.
            
            if VEREMI_EVIDENCE_ENABLE and (p_veremi >= VEREMI_SOFT_SCORE or veremi_ev.get("reasons")):
                print("[VEREMI-EVIDENCE] Z%d CID:%d mode=%s old_p=%.3f p_veremi=%.3f p_edge=%.3f streak=%d reasons=%s details=%s" %
                      (ZONE_ID, cid, VEREMI_EVIDENCE_MODE, old_p_edge, p_veremi, p_edge,
                       int(veremi_ev.get("streak", 0)),
                       ",".join(veremi_ev.get("reasons", [])) or "-",
                       veremi_ev.get("details", {})))

            # Global speed baseline
            accept_global = False
            mode = GLOBAL_SPEED_HISTORY_MODE
            if mode == "all":
                accept_global = True
            elif mode == "safe_only":
                accept_global = (p_edge < ZONE_SAFE)
            else:
                accept_global = (p_edge < min(ZONE_SAFE, GLOBAL_SPEED_ACCEPT_SUSP_MAX))
            if accept_global and spd <= SPEED_THRESHOLD_CAP:
                with _state_lock:
                    global_speed_history.append(spd)

            # Zone decision
            if p_edge >= ZONE_MALICIOUS:
                base = "BAN"
            elif p_edge >= ZONE_SAFE:
                base = "WARN"
            else:
                base = "SAFE"

            with _state_lock:
                if base == "BAN":
                    cid_ban_streak[cid]  += 1
                    cid_warn_streak[cid]  = 0
                elif base == "WARN":
                    cid_warn_streak[cid] += 1
                    cid_ban_streak[cid]   = 0
                else:
                    cid_ban_streak[cid]   = 0
                    cid_warn_streak[cid]  = 0
                ban_streak  = cid_ban_streak[cid]
                warn_streak = cid_warn_streak[cid]

            verdict = base
            if base == "BAN" and int(EDGE_BAN_CONFIRM_K) > 1 and ban_streak < int(EDGE_BAN_CONFIRM_K):
                verdict = "WARN"

            if verdict == "BAN":
                with _state_lock:
                    confirmed_banned_set.add(cid)

            if verdict == "WARN" and SAFEWIN_WARN_SUPPRESS == 1 and safeWins > 0 and p_edge < SAFEWIN_WARN_SUPPRESS_MAX:
                verdict = "SAFE"
                with _state_lock:
                    cid_warn_streak[cid] = 0

            if verdict in ("WARN", "BAN"):
                with _state_lock:
                    if cid not in detection_latency:
                        detection_latency[cid] = sim_ts
                    if cid not in cid_first_warn_simts:
                        cid_first_warn_simts[cid] = sim_ts
                    if cloud_fb_received:
                        cid_postcloud_verdicts[cid].append(verdict)
                    else:
                        cid_precloud_verdicts[cid].append(verdict)

            print("[EDGE-Z%d-ENSEMBLE] CID:%d m1=%.3f m2=%.3f m3=%.3f m4=%.3f m5=%.3f "
                  "p=%.3f cloud=%s overlap=%s -> %s"
                  % (ZONE_ID, cid, m1, m2, m3, m4, m5, p_edge,
                     "POST" if cloud_fb_received else "PRE",
                     "YES" if in_overlap else "NO",
                     verdict))

            # [MU-6] Send OVERLAP_SCORE if this CID arrived via handover
            if in_overlap:
                threading.Thread(
                    target=send_overlap_score,
                    args=(cid, verdict, p_edge, sim_ts),
                    daemon=True
                ).start()

            resp = build_telem_response(cid, ts, spd, hdg, px, py, lan,
                                         m1, m2, m3, m4, m5, p_edge, verdict, sim_ts)
            send_framed(conn, resp)
            with _state_lock:
                stats[cid]["pkt"]           += 1
                stats[cid][verdict.lower()] += 1
            return

        print("[EDGE-Z%d] Unknown msg: %s" % (ZONE_ID, msg[:80]))
        send_framed(conn, "ERROR unknown_message")

    except Exception as e:
        print("[EDGE-Z%d] Handler error %s: %s" % (ZONE_ID, str(addr), str(e)))
    finally:
        try: conn.close()
        except: pass

# =============================================================================
# MAIN
# =============================================================================

def main():
    print("=" * 64)
    print(" EDGE AI SERVER %s -- Zone %d" % (VERSION, ZONE_ID))
    print("=" * 64)
    print("[EDGE-Z%d] Port              : %d" % (ZONE_ID, PORT))
    print("[EDGE-Z%d] Coordinator       : %s:%d" % (ZONE_ID, COORD_HOST, COORD_PORT))
    print("[EDGE-Z%d] ZONE_SAFE=%.2f  ZONE_MALICIOUS=%.2f  NASH_P*=%.4f"
          % (ZONE_ID, ZONE_SAFE, ZONE_MALICIOUS, NASH_P_STAR))
    print("[EDGE-Z%d] Weights: W1=%.2f W2=%.2f W3=%.2f W4=%.2f W5=%.2f"
          % (ZONE_ID, W1, W2, W3, W4, W5))
    print("[EDGE-Z%d] LEARNING_RATE=%.3f  W_MIN=%.2f  NASH_BAN_CONFIRM_K=%d"
          % (ZONE_ID, LEARNING_RATE, W_MIN, NASH_BAN_CONFIRM_K))
    print("[CLOUD-DELAY] RTT=%.0fms  pre-cloud-pkts=%d"
          % (CLOUD_RTT_MS, CLOUD_PRECLOUD_PKTS))

    save_config_snapshot()
    trace_event("startup", event_level="info",
                port=PORT, zone_id=ZONE_ID, version=VERSION,
                coord_host=COORD_HOST, coord_port=COORD_PORT,
                weights={"W1": W1, "W2": W2, "W3": W3, "W4": W4, "W5": W5},
                zone_safe=ZONE_SAFE, zone_malicious=ZONE_MALICIOUS,
                nash_p_star=round(NASH_P_STAR, 4))

    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind((HOST, PORT))
    srv.listen(MAX_CLIENTS)

    _shutdown_flag = threading.Event()

    def _shutdown_handler(signum, frame):
        print("[EDGE-Z%d] Signal %d — shutting down..." % (ZONE_ID, signum))
        _shutdown_flag.set()
        srv.close()

    signal.signal(signal.SIGTERM, _shutdown_handler)
    signal.signal(signal.SIGINT,  _shutdown_handler)

    print("[EDGE-Z%d] Ready on port %d\n" % (ZONE_ID, PORT))

    try:
        while not _shutdown_flag.is_set():
            try:
                conn, addr = srv.accept()
                threading.Thread(target=handle_client,
                                 args=(conn, addr),
                                 daemon=True).start()
            except OSError:
                break
            except KeyboardInterrupt:
                break
            except Exception as e:
                if not _shutdown_flag.is_set():
                    print("[EDGE-Z%d] Accept error: %s" % (ZONE_ID, e))
    finally:
        print("[EDGE-Z%d] Saving metrics before exit..." % ZONE_ID)
        print_metrics()
        save_metrics_json()
        try: srv.close()
        except: pass


if __name__ == "__main__":
    main()
